{
  "name": "@finra-ui/storybook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "preview": "npx vite preview --outDir storybook-static",
    "format": "biome format --write . && prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "biome format . && prettier --check . --ignore-path ../../.prettierignore",
    "lint": "biome check . && prettier --check . --ignore-path ../../.prettierignore",
    "lint:fix": "biome check --write . && prettier --write . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@utk09/finra-ui": "workspace:*",
    "@utk09/finra-ui-finance": "workspace:*",
    "@utk09/finra-ui-icons": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
