{
  "name": "@utk09/finra-ui-icons",
  "version": "0.4.0",
  "description": "Icon library for Finra UI. Framework-agnostic SVG data with React wrappers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/strip-style-imports.mjs dist",
    "dev": "vite build --watch",
    "format": "biome format --write . && prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "biome format . && prettier --check . --ignore-path ../../.prettierignore",
    "lint": "biome check . && prettier --check . --ignore-path ../../.prettierignore",
    "lint:fix": "biome check --write . && prettier --write . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "author": {
    "name": "@utk09"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/utk09/finra-ui",
    "directory": "packages/icons"
  },
  "license": "Apache-2.0",
  "keywords": [
    "icons",
    "svg",
    "react",
    "finra-ui"
  ]
}
