{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "stories/**",
        "../../config/**",
        "../../scripts/**",
        "../../tsconfig.base.json",
        "../../tsconfig.build.json"
      ],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "stories/**",
        ".storybook/**",
        "../../biome.jsonc",
        "../../plugins/**",
        "../../.prettierrc.json",
        "../../.prettierignore"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "test/**",
        "../../config/**",
        "../../vitest.config.ts"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "test/**", "../../config/**"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "stories/**",
        ".storybook/**",
        "../../tsconfig.base.json"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
